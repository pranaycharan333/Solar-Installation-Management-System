# Required by the backend server
PORT=5000
DATABASE_URL="postgresql://postgres:replace-with-your-database-password@localhost:5432/solarops?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"

# Required by the database seed script; use credentials you choose locally
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
TECHNICIAN_SEED_PASSWORD="replace-with-a-strong-technician-password"
CUSTOMER_SEED_PASSWORD="replace-with-a-strong-customer-password"
ALLOW_DESTRUCTIVE_SEED=false
ADMIN_NAME="SolarOps Administrator"
ADMIN_PHONE="replace-with-admin-phone"

# Frontend development URL (currently permissive CORS is configured in server.ts)
CORS_ORIGIN="http://localhost:5173"

# Google Identity Services: Web application OAuth client ID (not a client secret)
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
